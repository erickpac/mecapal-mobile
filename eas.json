{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "pnpm": "10.31.0"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://me-39b909563c194825b97b50e4fb6d423e.ecs.us-east-1.on.aws/api/"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "autoIncrement": true,
      "android": {
        "distribution": "internal",
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://me-39b909563c194825b97b50e4fb6d423e.ecs.us-east-1.on.aws/api/"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.mekapal.com/api/"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "appleId": "mekapal@corplha.com",
        "ascAppId": "6765531197",
        "appleTeamId": "7D94PAKFK8"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    },
    "production": {
      "ios": {
        "appleId": "mekapal@corplha.com",
        "ascAppId": "your-production-asc-app-id",
        "appleTeamId": "7D94PAKFK8"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
